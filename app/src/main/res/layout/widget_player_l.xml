<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/w_cover"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:maxWidth="128dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_apk" />

    <LinearLayout
        android:id="@+id/w_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="DATAMOSH"
            android:scaleType="fitStart"
            android:src="@drawable/logo_fm" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="DATAMOSH FM"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B8B8C0"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/w_like"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@null"
        android:contentDescription="Лайк"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_heart" />

    <ImageButton
        android:id="@+id/w_play"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@null"
        android:contentDescription="Play/Pause"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_play" />
</LinearLayout>
